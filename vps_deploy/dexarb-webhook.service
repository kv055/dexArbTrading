[Unit]
Description=DexArbTrading GitHub webhook listener
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/dexArbTrading
ExecStart=/usr/bin/webhook -verbose -hotreload -ip 0.0.0.0 -port 9000 -hooks /opt/dexArbTrading/vps_deploy/hooks.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
