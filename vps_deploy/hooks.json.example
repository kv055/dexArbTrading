[
  {
    "id": "dexarb-redeploy",
    "execute-command": "/opt/dexArbTrading/vps_deploy/webhook-handler.sh",
    "command-working-directory": "/opt/dexArbTrading",
    "response-message": "webhook received",
    "pass-environment-to-command": [
      {
        "source": "string",
        "name": "/opt/dexArbTrading",
        "envname": "REPO_DIR"
      },
      {
        "source": "string",
        "name": "light_setting",
        "envname": "BRANCH"
      },
      {
        "source": "string",
        "name": "origin",
        "envname": "REMOTE"
      },
      {
        "source": "string",
        "name": "/opt/dexArbTrading/docker-compose.yml",
        "envname": "COMPOSE_FILE"
      },
      {
        "source": "string",
        "name": "kv055/dexArbTrading",
        "envname": "EXPECTED_REPO_FULL_NAME"
      },
      {
        "source": "string",
        "name": "/tmp/dexarb-webhook-last-ping",
        "envname": "PING_STATUS_FILE"
      },
      {
        "source": "header",
        "name": "X-GitHub-Event",
        "envname": "HOOK_EVENT"
      },
      {
        "source": "payload",
        "name": "ref",
        "envname": "HOOK_REF"
      },
      {
        "source": "payload",
        "name": "repository.full_name",
        "envname": "HOOK_REPOSITORY_FULL_NAME"
      },
      {
        "source": "payload",
        "name": "zen",
        "envname": "HOOK_ZEN"
      }
    ],
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "value",
            "value": "kv055/dexArbTrading",
            "parameter": {
              "source": "payload",
              "name": "repository.full_name"
            }
          }
        },
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "replace-with-a-random-secret",
            "parameter": {
              "source": "header",
              "name": "X-Hub-Signature-256"
            }
          }
        },
        {
          "or": [
            {
              "match": {
                "type": "value",
                "value": "push",
                "parameter": {
                  "source": "header",
                  "name": "X-GitHub-Event"
                }
              }
            },
            {
              "match": {
                "type": "value",
                "value": "ping",
                "parameter": {
                  "source": "header",
                  "name": "X-GitHub-Event"
                }
              }
            }
          ]
        }
      ]
    }
  }
]
