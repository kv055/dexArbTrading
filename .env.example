# Container registry (GHCR) coordinates used by docker-compose.yml.
# IMAGE_OWNER must be the lowercase GitHub owner that hosts the packages.
# IMAGE_TAG defaults to `latest`; set to a git SHA to pin/rollback.
IMAGE_OWNER=kv055
IMAGE_TAG=latest

POSTGRES_DB=dexarb
POSTGRES_ADMIN_USER=dex_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin_password
POSTGRES_UNIFIED_API_PASSWORD=change_me_unified_api_password
POSTGRES_MONITOR_PASSWORD=change_me_monitor_password
POSTGRES_MM_CONTROLLER_PASSWORD=change_me_mm_controller_password
POSTGRES_FIAT_CONTROLLER_PASSWORD=change_me_fiat_controller_password

# Grafana admin password (used to log into https://<host>:5443/grafana/ as `admin`).
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password

# Read-only Grafana service-account token handed to scraping agents so they can
# query the Prometheus/Loki/Tempo datasources over the TLS edge. NOT consumed by
# any compose service — kept here as the documented home (store the real value in
# .env.enc). Mint it once with deploy/monitoring/grafana/bootstrap-agent-token.sh;
# see deploy/monitoring/README.md "Agent datasource access".
GRAFANA_AGENT_TOKEN=

# ─── OpenTelemetry (logs + traces) ───────────────────────────────────────────
# All optional — docker-compose ships sensible defaults. The Go services push
# OTLP traces to Alloy, which forwards to Tempo; structured JSON logs go to
# stdout and Alloy scrapes them into Loki. View both in Grafana.
#   OTEL_EXPORTER_OTLP_ENDPOINT  collector address (default alloy:4317). Empty
#                                disables tracing entirely.
#   OTEL_TRACES_SAMPLER_ARG      head sampling ratio 0..1 (default 1.0; lower in
#                                prod if trace volume gets heavy).
#   LOG_LEVEL                    debug|info|warn|error (default info).
#   DEPLOY_ENV                   resource attribute deployment.environment.
# OTEL_EXPORTER_OTLP_ENDPOINT=alloy:4317
# OTEL_TRACES_SAMPLER_ARG=1.0
# LOG_LEVEL=info
# DEPLOY_ENV=production

# Shared secret guarding the unified-api internal ingest endpoint
# (POST /internal/live_offers). The snapshot tool sends it as the
# X-Internal-Secret header; the server rejects mismatches with 401. Leave empty
# to disable the check (dev/local). Set to a long random value in production.
INTERNAL_API_SECRET=change_me_internal_api_secret

# Postgres logical backups. The postgres-backup sidecar creates pg_dump -Fc
# archives and uploads them with rclone copy.
PG_BACKUP_ENABLED=true
PG_BACKUP_INTERVAL=6h
PG_BACKUP_FILE_PREFIX=dexarb
PG_BACKUP_RETENTION_DAYS=14
PG_BACKUP_UPLOAD=true
PG_BACKUP_UPLOAD_REQUIRED=true
PG_BACKUP_RCLONE_REMOTE=proton:postgres-backups/dexarb
PG_BACKUP_COMMAND_TIMEOUT=2h

# Proton Drive primary target. Rclone's Proton Drive backend is beta, so test
# unattended uploads before relying on it.
RCLONE_CONFIG_PROTON_TYPE=protondrive
RCLONE_CONFIG_PROTON_USERNAME=your@email.com
RCLONE_CONFIG_PROTON_PASSWORD=
# RCLONE_CONFIG_PROTON_2FA=

# Dropbox fallback target. Generate the token once with `rclone config` on a
# trusted machine, then paste the token JSON here.
# PG_BACKUP_RCLONE_REMOTE=dropbox:postgres-backups/dexarb
# RCLONE_CONFIG_DROPBOX_TYPE=dropbox
# RCLONE_CONFIG_DROPBOX_TOKEN=

# ─── Bisq ─────────────────────────────────────────────────────────────────────
# Bisq 1 (gRPC on port 9998)
BISQ_API_PASSWORD=
BISQ_WALLET_PASSWORD=
BISQ_ACCOUNT_FILE_PATH=

# Bisq 2 (REST API on port 8090). Set BISQ2_VERSION once a target release is chosen.
BISQ2_VERSION=2.1.11
BISQ2_API_PASSWORD=
BISQ2_WALLET_PASSWORD=
BISQ2_ACCOUNT_FILE_PATH=

# ─── CI / act (local workflow testing) ───────────────────────────────────────
# These are only read by act (.github/act/run.sh). Never used by docker-compose.

# Required for all jobs — submodule checkout and bisq-bump gh api calls.
GH_PAT=your_github_pat_here

# Required for build-report job (gh api to post workflow summary). Leave empty to skip.
GITHUB_TOKEN=

# Required for pre-deploy / deploy jobs only. Leave empty when only running tests.
VPS_SSH_PRIVATE_KEY=
VPS_SSH_KNOWN_HOSTS=
VPS_SSH_HOST=
VPS_SSH_USER=
VPS_REPO_DIR=
DOTENV_PRIVATE_KEY_ROOT=
DOTENV_PRIVATE_KEY_UNIFIED_API=
DOTENV_PRIVATE_KEY_MONITOR=
DOTENV_PRIVATE_KEY_MM_CONTROLLER=
DOTENV_PRIVATE_KEY_FIAT_CONTROLLER=
