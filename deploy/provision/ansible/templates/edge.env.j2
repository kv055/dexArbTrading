# Managed by Ansible. Contains only certificate-routing metadata, not secrets.
EDGE_MODE={{ edge_mode | to_json }}
EDGE_CERT_TYPE={{ ('ip' if edge_mode == 'development' else 'domain') | to_json }}
EDGE_CERT_IDENTIFIER={{ (ansible_host if edge_mode == 'development' else public_hostname) | to_json }}
EDGE_HTTP01_WEBROOT={{ edge_http01_webroot | to_json }}
LETSENCRYPT_EMAIL={{ letsencrypt_email | to_json }}
