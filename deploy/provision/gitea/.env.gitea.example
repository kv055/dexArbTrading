# Gitea trial-run configuration.
# Copy to .env.gitea (gitignored) and fill in. Consumed by setup-gitea.sh.

# Base URL of the Gitea instance over Tailscale. No trailing slash, no /api.
# Used by THIS machine (your laptop) for repo/secret/API calls, so it must be
# reachable from here — the Tailscale IP is ideal.
#   e.g. https://gitea.<your-tailnet>.ts.net   or   http://100.64.0.1:3000
GITEA_URL="https://gitea.example-tailnet.ts.net"

# Address the homeserver's CONTAINERS use to reach Gitea (runner instance URL,
# image-registry pushes, daemon.json). Only needed when the runner is co-located
# with Gitea: the Tailscale IP is NOT routable from inside Docker (Tailscale doesn't
# masquerade container traffic), so use a host-routable address such as the LAN IP.
# Leave unset/commented to default to GITEA_URL (runner on a separate machine).
#   e.g. http://192.168.2.57:8085
#GITEA_INTERNAL_URL="http://192.168.x.y:8085"

# User or org on Gitea that will own the repos (e.g. kv055).
GITEA_OWNER="kv055"

# A *Gitea* personal access token (NOT the GitHub PAT). Generate in Gitea under
# Settings -> Applications -> Generate New Token with scopes:
#   write:repository, write:package (push images to the Gitea registry),
#   write:organization (only if GITEA_OWNER is an org),
#   and repo admin / write:admin (needed to fetch a runner registration token).
GITEA_TOKEN="gitea_pat_xxxxxxxxxxxxxxxxxxxx"

# Label for this runner as it appears in the Gitea UI.
RUNNER_NAME="homeserver-1"

# Runner labels. The ubuntu-latest -> docker image mapping makes the existing
# `runs-on: ubuntu-latest` jobs resolve to a container image (same image as
# .github/act/actrc). Keep this unless you know you need more labels.
RUNNER_LABELS="ubuntu-latest:docker://catthehacker/ubuntu:act-22.04"

# SSH access to the homeserver where the runner will be started.
# Use the Tailscale IP (100.x.y.z) — MagicDNS *.ts.net names may not resolve.
HOMESERVER_SSH_USER="kili"
HOMESERVER_SSH_HOST="100.x.y.z"
# Directory on the homeserver where runner files are copied and compose is started.
HOMESERVER_RUNNER_DIR="~/gitea-runner"
