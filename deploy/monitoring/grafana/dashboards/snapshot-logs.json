{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "uid": "dexarb-snapshot-logs",
  "title": "Snapshot logs",
  "tags": ["dexarbtrading", "snapshot", "logs"],
  "timezone": "",
  "time": {"from": "now-3h", "to": "now"},
  "refresh": "30s",
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About this dashboard",
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "options": {"mode": "markdown", "content": "Per-snapshot view sourced **only from logs** (Loki) — the same data the snapshot worker prints each run.\n\n**Shown:** exchange names, total orders seen, per-exchange new/updated offers, closed-offer analysis, exchange-offline events, and dexMonitor lifecycle-enrichment problems.\n\n**Not available from logs** (would need a DB datasource or a small logging change — see plan): the full list of **order external IDs**, the **premium-at-write** count, and the exact **analytics-added-OK** count. The `[Lifecycle]` panel below only logs on *problem* batches, so it's an error monitor, not a success count. Closed-since-last-snapshot is approximated by `[ClosedAnalysis] processed=`."}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Snapshots (range)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 5},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(count_over_time({service=~\"unified-snapshot\"} |= \"snapshot complete\" [$__range]))", "queryType": "instant", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total offers (latest snapshot)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 5},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "last_over_time({service=~\"unified-snapshot\"} |= \"snapshot complete\" | json | unwrap offers [15m])", "queryType": "instant", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Total offers per snapshot",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 5, "w": 12, "x": 12, "y": 5},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10, "pointSize": 5, "showPoints": "always"}}, "overrides": []},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "last_over_time({service=~\"unified-snapshot\"} |= \"snapshot complete\" | json | unwrap offers [2m])", "queryType": "range", "legendFormat": "offers seen", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Snapshot completions (exchange names + total offers)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 10},
      "options": {"showTime": true, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "{service=~\"unified-snapshot\"} |= \"snapshot complete\" | json", "queryType": "range", "refId": "A"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "New offers per exchange (per interval)",
      "description": "Parsed from the '[exchange] N new, M updated (dir)' lines. new+updated approximates orders seen / baseline lifecycle rows written that snapshot.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 19},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "fillOpacity": 50, "stacking": {"mode": "normal"}}}, "overrides": []},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (exchange) (sum_over_time({service=~\"unified-snapshot\"} |~ \"[0-9]+ new,\" | regexp \"\\[(?P<exchange>[a-z0-9]+)\\] (?P<new>[0-9]+) new\" | unwrap new [$__interval]))", "queryType": "range", "legendFormat": "{{exchange}}", "refId": "A"}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Updated offers per exchange (per interval)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 19},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "fillOpacity": 50, "stacking": {"mode": "normal"}}}, "overrides": []},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (exchange) (sum_over_time({service=~\"unified-snapshot\"} |~ \"updated\" | regexp \"\\[(?P<exchange>[a-z0-9]+)\\] [0-9]+ new, (?P<updated>[0-9]+) updated\" | unwrap updated [$__interval]))", "queryType": "range", "legendFormat": "{{exchange}}", "refId": "A"}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Closed offers per snapshot (proxy: ClosedAnalysis)",
      "description": "processed = offers newly detected as closed and analyzed this run (proxy for 'closed since last snapshot'). analyzed = of those, how many got analytics.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 27},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10, "pointSize": 5, "showPoints": "always"}}, "overrides": []},
      "targets": [
        {"datasource": {"type": "loki", "uid": "loki"}, "expr": "last_over_time({service=~\"unified-snapshot\"} |= \"[ClosedAnalysis]\" |~ \"processed=\" | regexp \"processed=(?P<processed>[0-9]+)\" | unwrap processed [2m])", "queryType": "range", "legendFormat": "processed (closed)", "refId": "A"},
        {"datasource": {"type": "loki", "uid": "loki"}, "expr": "last_over_time({service=~\"unified-snapshot\"} |= \"[ClosedAnalysis]\" |~ \"analyzed=\" | regexp \"analyzed=(?P<analyzed>[0-9]+)\" | unwrap analyzed [2m])", "queryType": "range", "legendFormat": "analyzed", "refId": "B"}
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Closed-offer analysis ([ClosedAnalysis])",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 27},
      "options": {"showTime": true, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "{service=~\"unified-snapshot\"} |= \"[ClosedAnalysis]\"", "queryType": "range", "refId": "A"}]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Exchange offline events (closed counts)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 35},
      "options": {"showTime": true, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "{service=~\"unified-snapshot\"} |= \"exchange offline\" | json", "queryType": "range", "refId": "A"}]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "dexMonitor lifecycle enrichment problems ([Lifecycle])",
      "description": "Only printed when a batch has skips/errors. inserted = lifecycle rows written WITH analytics; insert_errs/update_errs = failures. Clean batches log nothing.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 35},
      "options": {"showTime": true, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "{service=~\"app|dexmonitor\"} |= \"[Lifecycle]\"", "queryType": "range", "refId": "A"}]
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Raw snapshot log stream",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 43},
      "options": {"showTime": true, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "{service=~\"unified-snapshot\"}", "queryType": "range", "refId": "A"}]
    }
  ]
}
