{
  "annotations": {"list": []},
  "editable": true,
  "schemaVersion": 39,
  "title": "Postgres",
  "tags": ["dexarbtrading", "postgres"],
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Active connections",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (datname) (pg_stat_activity_count)",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Transactions per second",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum by (datname) (rate(pg_stat_database_xact_commit[1m]))", "legendFormat": "commit {{datname}}", "refId": "A"},
        {"expr": "sum by (datname) (rate(pg_stat_database_xact_rollback[1m]))", "legendFormat": "rollback {{datname}}", "refId": "B"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum by (datname) (rate(pg_stat_database_blks_hit[5m])) / (sum by (datname) (rate(pg_stat_database_blks_hit[5m])) + sum by (datname) (rate(pg_stat_database_blks_read[5m])))",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Postgres up",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "pg_up", "refId": "A"}]
    }
  ]
}
