{
 "annotations": {
  "list": []
 },
 "editable": true,
 "schemaVersion": 39,
 "title": "Containers — cAdvisor",
 "tags": [
  "dexarbtrading",
  "containers"
 ],
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "CPU usage (cores)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[1m]))",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Memory usage (bytes)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "expr": "container_memory_usage_bytes{name!=\"\"}",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Memory vs. limit (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "expr": "100 * container_memory_usage_bytes{name!=\"\"} / on (name) container_spec_memory_limit_bytes{name!=\"\"}",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Network rx/tx (bytes/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "targets": [
    {
     "expr": "sum by (name) (rate(container_network_receive_bytes_total{name!=\"\"}[1m]))",
     "legendFormat": "rx {{name}}",
     "refId": "A"
    },
    {
     "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name!=\"\"}[1m]))",
     "legendFormat": "tx {{name}}",
     "refId": "B"
    }
   ]
  }
 ],
 "uid": "dexarb-containers"
}
