# SSH private key for CI to connect to the VPS (no passphrase).
# Generate with: ssh-keygen -t ed25519 -C "github-actions" -f ~/.ssh/github_actions_vps -N ""
# Then authorize it: ssh-copy-id -i ~/.ssh/github_actions_vps.pub <user>@<host>
# Paste the full contents of ~/.ssh/github_actions_vps here (including header/footer).
VPS_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----"

# VPS host fingerprints — all three lines from: ssh-keyscan -H <host>
# Paste the output lines (skip the # comment lines).
VPS_SSH_KNOWN_HOSTS="|1|<hash>= ssh-rsa AAAA...
|1|<hash>= ecdsa-sha2-nistp256 AAAA...
|1|<hash>= ssh-ed25519 AAAA..."

# IP address or hostname of the VPS.
VPS_SSH_HOST="1.2.3.4"

# SSH username on the VPS.
VPS_SSH_USER="your_user"

# Absolute path to the project directory on the VPS.
VPS_REPO_DIR="/home/your_user/dexArbTrading"
